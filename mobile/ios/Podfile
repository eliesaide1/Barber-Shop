# React Native ships a prebuilt binary of its own core and uses it by default,
# which makes installing and building considerably faster. It cannot be used
# here: react-native-nitro-image links against RN's internal C++ and the
# prebuilt core does not export what it reaches for, so the build ends in
#
#   "vtable for facebook::react::DebugStringConvertible", referenced from
#   ... libNitroImage.a — symbol(s) not found for architecture arm64
#
# Set here rather than remembered as an environment variable on somebody's
# machine, because `Pods/` is not in the repository: every fresh clone and
# every CI run installs pods again, and without this each one rediscovers that
# linker error with no idea what it has to do with a pod nobody edited.
#
# The cost is build time — RN's core is compiled rather than downloaded.
# Prebuilt becomes an option again once nitro-image links against it cleanly.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-firebase resolves firebase-ios-sdk through SPM, whose products are
# automatic (static) libraries — with React Native's default static linkage each
# Firebase pod embeds its own copy and they collide as duplicate symbols at link
# time, and `pod install` refuses to generate the project. Sourcing Firebase from
# CocoaPods instead keeps the static linkage the rest of the build expects.
$RNFirebaseDisableSPM = true

target 'VIABarberHouse' do
  config = use_native_modules!

  # FirebaseCoreInternal is Swift and imports GoogleUtilities, which is plain
  # Objective-C and ships no module map — so it cannot be integrated as a static
  # library without one. Opting this pod into modular headers generates it.
  # Done per-pod rather than with a global use_modular_headers!, which changes
  # header resolution for every React Native pod as well.
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Each pod carries its own podspec floor, and several are still on iOS 9.0 —
    # below the 12.0 Xcode now supports, so every one of them warns on each build.
    # Raise them to the app's own minimum, which they all already satisfy.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |pod_config|
        pod_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
    end
  end
end
