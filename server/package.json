{
  "name": "faderoom-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FadeRoom API — barber shop bookings, loyalty check-in and marketplace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
