# Copy to .env and adjust. .env is gitignored.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/faderoom

# Sign JWTs. Change these before anything leaves your machine.
JWT_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
ACCESS_TTL=30m
REFRESH_TTL=30d

# Signs the rotating check-in QR and the order / reward codes.
SHOP_SECRET=dev-only-change-me-shop

# Loyalty programme
LOYALTY_GOAL=5
CHECKIN_WINDOW_MS=60000
# One stamp per visit. 20s here so you can fill a card in a demo; set this to
# 14400000 (4 hours) in production, which is what actually enforces the rule.
CHECKIN_COOLDOWN_MS=20000
FREE_CUT_VALUE=25

# Bookings. A booking is a request until the artist accepts it and sets how
# long it will take, so nothing is held in the meantime — this caps how many
# requests one client may have waiting at once.
MAX_OPEN_REQUESTS=3

# Marketplace
DELIVERY_FEE=4
FREE_DELIVERY_OVER=50

# Push notifications (optional). Without these the API still delivers everything
# over Socket.IO to any app that is open, and stores it for the rest — push is
# only what wakes an app that is shut.
#
# Firebase Console → Project settings → Service accounts → Generate new private
# key. Use ONE of the two: the whole JSON on a single line, which is all a
# hosting dashboard can accept, or a path to the file, which is better on a
# server you control because the key never enters the environment.
#
# This key can send a notification to every user of the app. Treat it like the
# JWT secrets above.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…"}
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# Appointment reminders. Minutes before a booking to remind the client — a day
# ahead so they can move it, two hours ahead to get them out of the door. Set to
# an empty value to switch reminders off. The sweep interval only needs to be
# fine enough for the shortest lead; five minutes is plenty for a two-hour one.
REMINDER_LEAD_MINUTES=1440,120
REMINDER_SWEEP_MS=300000

# The shop's clock. A deployment runs in UTC while the chairs are in Beirut, and
# any time the API writes into a sentence ("your cut is at 17:45") is formatted
# with this. Times sent as ISO timestamps are unaffected — the phone and the
# browser render those in the reader's own zone, which is what they should do.
SHOP_TIMEZONE=Asia/Beirut

# Signing in with Google / Apple (optional — the email and password form always
# works). Each is offered only when its client ids are set here.
#
# Google: Firebase Console → Authentication → Sign-in method → Google, then
# Google Cloud → APIs & Services → Credentials for the ids. The WEB client id is
# the audience Google puts in an id token even for a sign-in on Android, so it
# is required and is folded into the accepted list automatically. Android needs
# its own OAuth client with your signing SHA-1 registered, or the sign-in fails
# on the device before it ever reaches this server.
# GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=1234567890-android.apps.googleusercontent.com,1234567890-ios.apps.googleusercontent.com
#
# Apple: the app's bundle id, from an Apple Developer account with Sign in with
# Apple enabled on the App ID.
# APPLE_CLIENT_IDS=com.faderoom

# WhatsApp, for birthday greetings (optional — without it the greeting still
# goes out inside the app, which needs nobody's approval).
#
# Meta Business → WhatsApp → API Setup gives both. The token that ships from
# that screen expires in 24 hours; a permanent one comes from a System User.
#
# The MESSAGE ITSELF is not configured here. WhatsApp does not let a business
# send unprompted text, so a birthday greeting has to be a template approved by
# Meta in advance; the CMS names that template and fills in its blanks.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Country code assumed for a number typed without one.
SHOP_DIAL_CODE=961

# Comma separated origins allowed to call the API (CMS dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Shown in the startup banner only. Uploaded images are served at the RELATIVE
# path /uploads/<file>, so each client resolves them against the base URL it
# already uses — the same API is reached on three different hostnames.
PUBLIC_URL=http://localhost:4000
